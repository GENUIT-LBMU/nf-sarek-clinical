/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-sarek-clinical Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments.
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'nf-sarek-clinical'
    author          = 'IMAXi Bioinformatics'
    homePage        = 'https://github.com/GENUIT-LBMU/nf-sarek-clinical'
    description     = 'Clinical interpretation postprocessing pipeline for nf-core/sarek WES cancer exome outputs'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
    doi             = ''
}

// Global default params, used in configs
params {
    // ── Required inputs ──────────────────────────────────────────────────────
    sarek_outdir        = null          // Path to nf-core/sarek results directory
    run_name            = null          // Run identifier (used for output naming)

    // ── Reference databases ──────────────────────────────────────────────────
    snpsift_jar         = null          // SnpSift.jar (from snpEff package)
    panel_bed           = null          // WES capture BED (for TMB calculation)
    samplesheet         = null          // sarek samplesheet (CSV); its optional extra columns identify patient and specimens in the reports
    sarek_version       = null          // nf-core/sarek release that produced --sarek_outdir (reports; default: <sarek_outdir>/pipeline_info/sarek_release.txt from run_full.sh)
    gene_coords_bed     = null          // Gene coordinates BED (for CNV annotation)
    gnomad_tsv          = null          // Local gnomAD panel resource (scripts/build_gnomad_panel.sh):
                                        //   gnomad_v4.1_panel.tsv.gz (+ .tbi). Path or https URL.
                                        //   Required for germline SNVs (frequency, BA1/BS1/PM2).
    gnomad_regions      = null          // Regions BED of that resource; default: <gnomad_tsv
                                        //   without .tsv.gz>_regions.bed.gz (+ .tbi)
    snpeff_mane_data    = null          // snpEff data dir holding the MANE database (<dir>/<snpeff_mane_db>/).
                                        //   When set, the germline and the somatic Mutect2 VCFs are re-annotated
                                        //   with MANE Select transcripts (sarek's snpEff -canon picks the longest CDS).
    snpeff_mane_db      = 'GRCh38.mane.1.2.refseq'
    mane_plus_clinical  = "${projectDir}/assets/mane/mane_v1.2_plus_clinical.txt"
                                        // MANE Plus Clinical transcripts of the snpeff_mane_db release:
                                        //   listed after MANE Select, their HGVS shown as secondary.
    clinvar_tsv         = null          // Local ClinVar panel resource (scripts/build_clinvar_panel.sh):
                                        //   clinvar_<DATE>_panel.tsv.gz (+ .tbi). Path or https URL.
                                        //   Required for germline SNVs (only ClinVar source).
    revel_tsv           = null          // Local REVEL v1.3 panel resource (scripts/build_revel_panel.py):
                                        //   revel_v1.3_panel.tsv.gz (+ .tbi), MANE Select score per allele.
                                        //   Required for germline SNVs (PP3 / BP4).
    clinvar_protein_index = null        // ClinVar P/LP missense in MANE protein coordinates
                                        //   (scripts/build_clinvar_protein_index.py) for ACMG PS1 / PM5
    spliceai            = true          // SpliceAI on the germline candidates (PP3 / BP4 for splicing)
    spliceai_fasta      = null          // GRCh38 FASTA (+ .fai) for SpliceAI; defaults to gcnv_fasta

    // ── Gene panels (built-in defaults used if not supplied) ─────────────────
    germline_panel      = "${projectDir}/assets/gene_panels/germline_cancer_predisposition.txt"
    somatic_cnv_panel   = "${projectDir}/assets/gene_panels/somatic_38_oncogenes.txt"
    somatic_snv_panel   = "${projectDir}/assets/gene_panels/somatic_snv_panel.txt"
    second_hit_panel    = "${projectDir}/assets/gene_panels/somatic_track_second_hit.txt"
                                        // second-hit genes outside the core panel: somatic SNVs for the
                                        //   germline-somatic correlation only (generated from genes.tsv)
    tso500_panel        = "${projectDir}/assets/gene_panels/somatic_track_tso500.txt"
    mane_cds_bed        = null          // MANE Select CDS BED (scripts/build_mane_exons.py --cds-bed):
                                        //   TMB territory = panel_bed ∩ CDS. Without it: whole capture (warning)
    cnv_gatk_genes      = "${projectDir}/assets/gene_panels/somatic_cnv_gatk_genes.txt"
                                        // genes annotated by the GATK somatic CNV R script
                                        //   (germline + somatic CNV panels, generated from genes.tsv)
                                        // TSO500 genes outside the core panel: pan-tumor somatic SNV track
                                        //   (generated from genes.tsv; null = no pan-tumor track)
    pharmaco_variants   = "${projectDir}/assets/pharmacogenomics_dpyd_variants.txt"

    // ── GATK Germline CNV references ─────────────────────────────────────────
    // Required when --skip_germline_cnv = false
    gcnv_ploidy_model   = null          // Pre-built ploidy model dir (DetermineGermlineContigPloidy COHORT output)
    gcnv_pon_dir        = null          // Pre-built gCNV PoN model dir (GermlineCNVCaller COHORT output)
    gcnv_interval_list  = null          // Preprocessed interval list (from CollectReadCounts + FilterIntervals)
    gcnv_fasta          = null          // Reference FASTA (full hg38.fa)
    gcnv_dict           = null          // Reference .dict (hg38.dict)
    gcnv_mane_txt       = null          // MANE transcript exon coordinates (exons_mane.txt)
    gcnv_lowmap_bed     = null          // Low-mappability BED for germline CNV flags (scripts/build_lowmap_panel.sh)
    civic_cache         = null          // Dated civicpy cache for CIViC annotation (scripts/build_civic_cache.sh)
    tumor_type          = null          // AMP tiering: CIViC disease terms joined by '|', for the whole run
    tumor_types         = null          // AMP tiering: TSV id<TAB>terms (patient, tumor sample or pair); overrides tumor_type
    cram_fasta          = null          // FASTA (+ .fai, .dict) Sarek wrote the CRAMs with; needed only when no BAM
    // exon_annotation.R is bundled in bin/ (from FlorPio/gatk-cnv-somatic)

    // ── GATK Somatic CNV references ──────────────────────────────────────────
    // Required when --skip_somatic_cnv_gatk = false
    somatic_pon_hdf5         = null     // Somatic PoN HDF5 (wes-do-gc.pon.hdf5)
    somatic_interval_list    = null     // Preprocessed interval list for somatic (preprocessed.interval_list)
    common_snps_vcf          = null     // Common SNPs VCF bgzipped + tabix (common_snps_preprocessed.vcf.gz)
    somatic_fasta            = null     // Reference FASTA – main chroms only (hg38.main_chroms.fa)
    somatic_dict             = null     // Reference .dict  (hg38.main_chroms.dict)
    // annotate_cnvs_complete_fixed.R is bundled in bin/ (from FlorPio/gatk-cnv-somatic)
    somatic_min_contig_length = 46709983 // Min contig length for GATK plots (hg38 chr22 ≈ 50 Mb)
    // Note: somatic and germline share the same MANE file; set gcnv_mane_txt for both.

    // ── Module toggles ────────────────────────────────────────────────────────
    skip_germline_snv   = false
    skip_germline_cnv   = false         // Germline GATK gCNV (requires gcnv_* params)
    skip_somatic_snv    = false
    skip_somatic_cnv    = false         // Somatic CNV interpretation (ASCAT+CNVkit)
    skip_somatic_cnv_gatk = false       // Somatic GATK CNV workflow (requires somatic_* params)
    skip_tmb            = false
    skip_signatures     = false
    skip_strelka_consensus = false      // Mutect2+Strelka2 consensus (falls back to Mutect2 if no Strelka2)
    skip_pharmaco       = false
    skip_coverage       = false
    skip_report         = false
    skip_pdf_report     = false         // Clinical PDF report (requires reportlab)

    // ── Analysis parameters ───────────────────────────────────────────────────
    genome_build        = 'GRCh38'      // GRCh37 or GRCh38
    // Legacy aliases — actual thresholds live in conf/filters.config
    amp_threshold       = null          // → params.filters.somatic_cnv.amp_threshold
    tmb_min_dp          = null          // → params.filters.somatic_snv.min_dp
    tmb_min_af          = null          // → params.filters.somatic_snv.min_af
    tmb_min_alt_reads   = null          // → params.filters.somatic_snv.min_alt_reads
    germline_min_dp     = null          // → params.filters.germline_snv.min_dp

    // ── SigProfiler ───────────────────────────────────────────────────────────
    sigprofiler_env     = 'spa_py310'   // Conda env name with SigProfilerAssignment

    // ── HRD Profiler ──────────────────────────────────────────────────────────
    skip_hrd            = false         // Skip HRProfiler HRD analysis
    hrd_organ           = 'BREAST'      // Organ type for HRD prediction model (BREAST|OVARIAN)

    // ── Report options ────────────────────────────────────────────────────────
    report_language     = 'en'          // Report language: 'en' (English) or 'es' (Spanish)

    // ── Docker images (custom builds) ─────────────────────────────────────────
    // Prefix for the custom-built images (civicpy, r-annotation, sigprofiler).
    // Default = 'nf-sarek-clinical' (matches `docker/build_local.sh` output).
    // Override to 'ghcr.io/GENUIT-LBMU/nf-sarek-clinical' (or your own registry)
    // when using pre-published images: --docker_namespace ghcr.io/your-org/...
    docker_namespace    = 'nf-sarek-clinical'

    // ── Output ────────────────────────────────────────────────────────────────
    outdir              = './results'
    publish_dir_mode    = 'copy'

    // ── Execution ─────────────────────────────────────────────────────────────
    max_memory          = '128.GB'
    max_cpus            = 16
    max_time            = '240.h'

    // ── nf-core boilerplate ───────────────────────────────────────────────────
    help                = false
    version             = false
    validate_params     = true
    monochrome_logs     = false
    hook_url            = null
    email               = null
    email_on_fail       = null
}

// Load base resources, centralized filters, and engine-agnostic container
// image assignments by default. Container directives are inert until a profile
// enables an engine (docker / singularity).
includeConfig 'conf/base.config'
includeConfig 'conf/filters.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    // Camino B — use the org-mirrored, digest-pinned images instead of the
    // upstream public tags. Combine with an engine: -profile docker,mirror
    // (or singularity,mirror). Regenerate conf/containers.mirror.config with
    // docker/mirror_images.sh after pushing the mirror.
    mirror {
        includeConfig 'conf/containers.mirror.config'
    }
}

// Export these variables to prevent local Python/R libs from conflicting with containers
// Also export all filter thresholds so bin/*.py scripts and inline Python can read them
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"

    // ── Filter thresholds from conf/filters.config → env vars for Python scripts ──
    FILT_VAF_MIN_HIGH       = "${params.filters.germline_snv.vaf_min_high}"
    FILT_VAF_MIN_MOD        = "${params.filters.germline_snv.vaf_min_moderate}"
    FILT_VAF_FLOOR_MIN_DP   = "${params.filters.germline_snv.vaf_floor_min_dp}"
    FILT_VAF_MAX            = "${params.filters.germline_snv.vaf_max}"
    FILT_MULTI_HIT_DIST     = "${params.filters.germline_snv.multi_hit_distance}"
    FILT_MULTI_HIT_VAF      = "${params.filters.germline_snv.multi_hit_vaf}"
    FILT_MULTI_HIT_MIN_GQ   = "${params.filters.germline_snv.multi_hit_min_gq}"
    FILT_GERMLINE_CNV_MIN_QA = "${params.filters.germline_cnv.min_qa}"
    FILT_SOMATIC_MAX_POP_AF = "${params.filters.somatic_snv.max_pop_af}"
    QC_ASCAT_MIN_PURITY     = "${params.filters.ascat.min_purity}"
    QC_ASCAT_MIN_GOF        = "${params.filters.ascat.min_goodness_of_fit}"
    QC_ASCAT_PLOIDY_NOTE    = "${params.filters.ascat.ploidy_note}"
    FILT_GERMLINE_CNV_LOWMAP_FRAC = "${params.filters.germline_cnv.lowmap_min_frac}"
    ACMG_BA1_AF             = "${params.filters.acmg.ba1_af}"
    ACMG_PM2_AF             = "${params.filters.acmg.pm2_af}"
    ACMG_BS1_AF             = "${params.filters.acmg.bs1_af}"
    ACMG_FREQ_METRIC        = "${params.filters.acmg.frequency_metric}"
    ACMG_PVS1_SCORE         = "${params.filters.acmg.pvs1_score}"
    ACMG_PVS1_STRONG_SCORE  = "${params.filters.acmg.pvs1_strong_score}"
    ACMG_PVS1_MODERATE_SCORE = "${params.filters.acmg.pvs1_moderate_score}"
    ACMG_PVS1_LAST_EXON_MIN_LOST = "${params.filters.acmg.pvs1_last_exon_min_lost}"
    ACMG_PVS1_NA_GENES      = "${params.filters.acmg.pvs1_not_applicable}"
    ACMG_PM4_SCORE          = "${params.filters.acmg.pm4_score}"
    ACMG_PM2_SCORE          = "${params.filters.acmg.pm2_score}"
    ACMG_BS1_SCORE          = "${params.filters.acmg.bs1_score}"
    ACMG_BS1_SUP_SCORE      = "${params.filters.acmg.bs1_sup_score}"
    ACMG_PM1_SCORE          = "${params.filters.acmg.pm1_score}"
    ACMG_PM1_SUP_SCORE      = "${params.filters.acmg.pm1_sup_score}"
    ACMG_VCEP_SPECS         = "${params.filters.acmg.vcep_specs}"
    ACMG_REVEL_PP3_STRONG   = "${params.filters.acmg.revel_pp3_strong}"
    ACMG_REVEL_PP3_MOD      = "${params.filters.acmg.revel_pp3_moderate}"
    ACMG_REVEL_PP3_SUP      = "${params.filters.acmg.revel_pp3_sup}"
    ACMG_REVEL_BP4_SUP      = "${params.filters.acmg.revel_bp4_sup}"
    ACMG_REVEL_BP4_MOD      = "${params.filters.acmg.revel_bp4_moderate}"
    ACMG_REVEL_BP4_STRONG   = "${params.filters.acmg.revel_bp4_strong}"
    ACMG_SPLICEAI_PP3       = "${params.filters.acmg.spliceai_pp3}"
    ACMG_PS1_SCORE          = "${params.filters.acmg.ps1_score}"
    ACMG_PM5_SCORE          = "${params.filters.acmg.pm5_score}"
    ACMG_SPLICEAI_BP4       = "${params.filters.acmg.spliceai_bp4}"
    ACMG_SCORE_P            = "${params.filters.acmg.score_p}"
    ACMG_SCORE_LP           = "${params.filters.acmg.score_lp}"
    ACMG_SCORE_LB           = "${params.filters.acmg.score_lb}"
    ACMG_SCORE_B            = "${params.filters.acmg.score_b}"
    ACMG_CLINVAR_MIN_STARS  = "${params.filters.acmg.clinvar_min_stars}"
    BIO_TMB_HIGH            = "${params.filters.biomarkers.tmb_high}"
    BIO_TMB_BORDERLINE      = "${params.filters.biomarkers.tmb_borderline}"
    BIO_MSI_HIGH            = "${params.filters.biomarkers.msi_high}"
    BIO_MSI_BORDERLINE      = "${params.filters.biomarkers.msi_borderline}"
    BIO_HRD_HIGH            = "${params.filters.biomarkers.hrd_high}"
    BIO_HRD_BORDERLINE      = "${params.filters.biomarkers.hrd_borderline}"
    QC_LOW_COV_THRESHOLD    = "${params.filters.qc.low_cov_threshold}"
    SIG_MIN_FRACTION        = "${params.filters.signatures.min_fraction}"
    SIG_MIN_COUNT           = "${params.filters.signatures.min_count}"
    SIG_MIN_TOTAL_SBS       = "${params.filters.signatures.min_total_sbs}"
    SIG_MIN_TOTAL_ID        = "${params.filters.signatures.min_total_id}"
    SIG_MMR_SBS             = "${params.filters.signatures.mmr_sbs}"
    SIG_MMR_ID              = "${params.filters.signatures.mmr_id}"
    SIG_HRD_SBS             = "${params.filters.signatures.hrd_sbs}"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// Function to ensure that resource requirements don't go beyond a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "  ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "  ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "  ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
