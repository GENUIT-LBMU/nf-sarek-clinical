FROM python:3.10-slim

LABEL maintainer="IMAXi Bioinformatics"
LABEL description="SigProfilerAssignment + SigProfilerMatrixGenerator container for nf-sarek-clinical mutational signatures"

# Build tools required by some SigProfiler C extensions + procps for Nextflow task metrics
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        wget \
        libgomp1 \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Install SigProfiler packages
# Pin major versions; update when COSMIC database versions change
RUN pip install --no-cache-dir \
    SigProfilerMatrixGenerator==1.3.6 \
    SigProfilerAssignment==1.1.3

# Pre-install the GRCh38 reference for SigProfilerMatrixGenerator
# This downloads ~300 MB of chromosome reference data to make the image fully self-contained.
RUN python3 -c "from SigProfilerMatrixGenerator import install; install.install('GRCh38', rsync=False, bash=True)"

# SigProfiler libraries write files into their own package directories at runtime
# (templates, CosmicTemplates, references, pickle files).
# Make all SigProfiler package dirs world-writable so non-root users can run them.
RUN chmod -R 777 \
    /usr/local/lib/python3.10/site-packages/sigProfilerPlotting/ \
    /usr/local/lib/python3.10/site-packages/SigProfilerMatrixGenerator/ \
    /usr/local/lib/python3.10/site-packages/SigProfilerAssignment/ \
    2>/dev/null || true

CMD ["/bin/bash"]
