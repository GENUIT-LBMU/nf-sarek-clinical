# mulled-v2 biocontainer (R + GenomicRanges + data.table) pinned by digest.
# Update: docker buildx imagetools inspect <ref> --format '{{.Manifest.Digest}}'
FROM quay.io/biocontainers/mulled-v2-c278c7398beb73294d78639a864352abef2931ce@sha256:bff551cd1a2dc15ac210844973ef8a57429dd1218f4dcce9df0b98b471c71cde

LABEL maintainer="IMAXi Bioinformatics"
LABEL description="R annotation container with optparse, dplyr, tidyr, GenomicRanges, data.table for nf-sarek-clinical"

# Install additional CRAN packages needed by annotation R scripts
# (GenomicRanges and data.table already present in base image).
# Pin to a dated Posit Public Package Manager snapshot so install.packages()
# resolves deterministically (frozen CRAN state) instead of tracking HEAD.
# Bump the date to update; fail the build if any package is missing.
RUN Rscript -e "\
    options(repos = c(CRAN = 'https://packagemanager.posit.co/cran/2026-06-01')); \
    pkgs <- c('optparse', 'dplyr', 'tidyr'); \
    install.packages(pkgs, Ncpus = 4, quiet = TRUE); \
    missing <- pkgs[!pkgs %in% rownames(installed.packages())]; \
    if (length(missing)) stop('Failed to install: ', paste(missing, collapse = ', '))"

CMD ["/bin/bash"]
