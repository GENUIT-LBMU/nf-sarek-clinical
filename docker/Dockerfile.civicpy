# python:3.11-slim pinned by digest (3.11.15-slim-trixie, captured 2026-06-09).
# Update: docker buildx imagetools inspect python:3.11-slim --format '{{.Manifest.Digest}}'
FROM python@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0

LABEL maintainer="IMAXi Bioinformatics"
LABEL description="civicpy + bcftools container for nf-sarek-clinical CIViC annotation step"

# Install system dependencies (bcftools, tabix, htslib)
RUN apt-get update && apt-get install -y --no-install-recommends \
        bcftools \
        tabix \
        wget \
        curl \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Install civicpy and its full transitive closure from the pinned lock file
# (requirements.civicpy.txt). pandas/numpy come in here and are reused by
# SOMATIC_CNV_INTERPRET (parse_somatic_cnv.py).
COPY requirements.civicpy.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Pre-populate the CIViC cache at build time by downloading the nightly pkl.
# Using --soft: downloads remote pre-built cache (avoids GraphQL rebuild).
# This cache is bundled in the image so runtime annotation works offline.
RUN civicpy update --soft || true

CMD ["/bin/bash"]
