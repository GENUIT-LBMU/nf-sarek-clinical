/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test profile: -stub run on a fake sarek output (CI)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bash tests/stub/make_fixture.sh
    nextflow run . -profile test -stub --outdir results_test

    Checks the wiring of the whole workflow (channels, joins, report inputs) with
    the stub blocks of every module; no tool runs and no container is needed.
    The scientific code is checked by the unit tests (tests/, pytest).
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Stub run on a fake sarek output'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    sarek_outdir = "${projectDir}/tests/stub/fixture/sarek_results"
    run_name     = 'test_stub'
    samplesheet  = "${projectDir}/tests/stub/fixture/samplesheet.csv"
    genome_build = 'GRCh38'
    tumor_type   = 'Colorectal Cancer'

    snpsift_jar  = "${projectDir}/tests/stub/fixture/resources/snpSift.jar"
    gnomad_tsv   = "${projectDir}/tests/stub/fixture/resources/gnomad_panel.tsv.gz"
    clinvar_tsv  = "${projectDir}/tests/stub/fixture/resources/clinvar_panel.tsv.gz"
    revel_tsv    = "${projectDir}/tests/stub/fixture/resources/revel_panel.tsv.gz"
    civic_cache  = "${projectDir}/tests/stub/fixture/resources/civicpy_cache.pkl"
    spliceai     = false
    gcnv_fasta   = "${projectDir}/tests/stub/fixture/resources/genome.fa"   // consensus (bcftools norm)

    // Need real references / panels of normals: not part of the stub test
    skip_germline_cnv     = true
    skip_somatic_cnv_gatk = true
}
