/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test configuration for nf-sarek-clinical
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources for CI
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input (update with real test data path or S3 bucket)
    sarek_outdir = 'https://raw.githubusercontent.com/your-org/nf-sarek-clinical/dev/test-data/sarek_results'
    run_name     = 'test_run'
    genome_build = 'GRCh38'

    // Skip heavy tools in CI
    skip_germline_cnv     = true
    skip_somatic_cnv_gatk = true
    skip_signatures       = true
}
