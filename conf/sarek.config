/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Lab-fixed nf-core/sarek parameters
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by run_full.sh / run_github.sh:
        nextflow run nf-core/sarek -c <run.config> -c <this file> -params-file <lab.yml> ...

    These parameters are constant across runs and DO NOT contain site-specific
    paths. Site paths (intervals, ASCAT alleles/loci) come from the params-file
    (full_pipeline.params.yml or your lab_params.yml). See README → "Reference
    files" for the keys you must define.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Genome & variant calling
    // NOTE: --tools is intentionally passed on the CLI in run_full.sh, NOT here.
    // sarek's conf/modules/mutect2.config wraps the MUTECT2_PAIRED process config
    // in an `if (params.tools)` block. Nextflow evaluates that condition at config
    // load time, before -c config files are applied. If tools is only in this file,
    // the condition evaluates false, MUTECT2_PAIRED never gets --f1r2-tar-gz in its
    // ext.args, LearnReadOrientationModel has no input, and the join for
    // FilterMutectCalls fails with "Join mismatch". Passing --tools on the CLI
    // ensures it is known at config load time.
    genome                        = 'GATK.GRCh38'
    save_output_as_bam            = true
    wes                           = true
    // NOTE: only_paired_variant_calling must NOT be set (default = false).
    // Despite the name, when = true, sarek's code filters OUT paired normals from the
    // germline calling channel (it keeps only STANDALONE normals without a tumor).
    // Result: HaplotypeCaller never runs for any normal that has a matched tumor.
    // Leave this param absent/false so all normals go to HaplotypeCaller regardless of pairing.

    // ASCAT genome build (the actual allele/loci paths come from -params-file)
    ascat_genome                  = 'hg38'

    // Site-specific paths — DO NOT hardcode here. Define in your params-file:
    //   intervals       : WES capture BED (e.g. Agilent SureSelect Human All Exon V7)
    //   ascat_alleles   : ASCAT alleles ZIP for ${ascat_genome}
    //   ascat_loci      : ASCAT loci ZIP
    //   ascat_loci_gc   : ASCAT loci GC ZIP
    //   ascat_loci_rt   : ASCAT loci RT ZIP
}
