/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Docker container configuration for nf-sarek-clinical
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Build custom images with:
      docker build -f docker/Dockerfile.civicpy   -t ghcr.io/<org>/nf-sarek-clinical/civicpy:5.2.0   docker/
      docker build -f docker/Dockerfile.sigprofiler -t ghcr.io/<org>/nf-sarek-clinical/sigprofiler:0.1.7 docker/
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // SnpSift / snpEff – annotation and field extraction
    withLabel:snpsift {
        container = 'quay.io/biocontainers/snpeff:5.1--hdfd78af_2'
    }
    // bcftools – VCF manipulation, CIViC field extraction, TMB normalisation
    withLabel:bcftools {
        container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'
    }
    // GATK – CollectReadCounts, DenoiseReadCounts, ModelSegments, gCNV, plots
    // gatk:4.6.2.0 required for gcnvkernel 0.9 (4.5.0.0 has 0.8 which cannot read 0.9 models)
    withLabel:gatk {
        container = 'broadinstitute/gatk:4.6.2.0'
    }
    // Python – parse_somatic_cnv.py (pandas/numpy) + FINAL_REPORT
    withLabel:python {
        // uses civicpy image (python 3.11 + pandas available as dependency)
        container = 'ghcr.io/your-org/nf-sarek-clinical/civicpy:5.2.0'
    }
    // R base + data.table + optparse + dplyr + tidyr + GenomicRanges – gene coverage, MANE annotation
    // Build from docker/Dockerfile.r_annotation or provide your own registry image
    withLabel:r_base {
        container = 'ghcr.io/your-org/nf-sarek-clinical/r-annotation:1.0.0'
    }
    // civicpy – CIViC variant annotation
    // Build from docker/Dockerfile.civicpy or provide your own registry image
    withLabel:civicpy {
        container = 'ghcr.io/your-org/nf-sarek-clinical/civicpy:5.2.0'
    }
    // SigProfiler – mutational signature decomposition (COSMIC v3.4)
    // Build from docker/Dockerfile.sigprofiler or provide your own registry image
    withLabel:sigprofiler {
        container = 'ghcr.io/your-org/nf-sarek-clinical/sigprofiler:0.1.7'
    }
    // HRProfiler – Homologous Recombination Deficiency analysis (Chopra et al., 2024)
    // Public image includes GRCh38/GRCh37 genome data and all Python dependencies
    withLabel:hrprofiler {
        container = 'florpio/hrprofiler:1.0-full'
    }
}
