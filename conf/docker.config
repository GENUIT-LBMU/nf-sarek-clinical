/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Docker container configuration for nf-sarek-clinical
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Custom images (civicpy, r-annotation, sigprofiler) use the namespace prefix
    `${params.docker_namespace}` (default: 'nf-sarek-clinical', set in nextflow.config).

    Build locally:
        bash docker/build_local.sh        # tags as nf-sarek-clinical/<name>:<ver>

    Or use a published registry:
        nextflow run ... --docker_namespace ghcr.io/<org>/nf-sarek-clinical

    See docker/README.md for details.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // SnpSift / snpEff – annotation and field extraction
    withLabel:snpsift {
        container = 'quay.io/biocontainers/snpeff:5.1--hdfd78af_2'
    }
    // bcftools – VCF manipulation, CIViC field extraction, TMB normalisation
    withLabel:bcftools {
        container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'
    }
    // GATK – CollectReadCounts, DenoiseReadCounts, ModelSegments, gCNV, plots
    // gatk:4.6.2.0 required for gcnvkernel 0.9 (4.5.0.0 has 0.8 which cannot read 0.9 models)
    withLabel:gatk {
        container = 'broadinstitute/gatk:4.6.2.0'
    }
    // R base + data.table + optparse + dplyr + tidyr + GenomicRanges – gene coverage, MANE annotation
    // Build from docker/Dockerfile.r_annotation
    withLabel:r_base {
        container = "${params.docker_namespace}/r-annotation:1.0.0"
    }
    // civicpy – CIViC variant annotation + Python data tools (pandas/numpy).
    // Build from docker/Dockerfile.civicpy. Used by CIViC annotation AND by
    // generic Python parsing processes (e.g. SOMATIC_CNV_INTERPRET).
    withLabel:civicpy {
        container = "${params.docker_namespace}/civicpy:5.2.0"
    }
    // SigProfiler – mutational signature decomposition (COSMIC v3.4)
    // Build from docker/Dockerfile.sigprofiler
    withLabel:sigprofiler {
        container = "${params.docker_namespace}/sigprofiler:0.1.7"
    }
    // HRProfiler – Homologous Recombination Deficiency analysis (Chopra et al., 2024)
    // Public image includes GRCh38/GRCh37 genome data and all Python dependencies
    withLabel:hrprofiler {
        container = 'florpio/hrprofiler:1.0-full'
    }
}
