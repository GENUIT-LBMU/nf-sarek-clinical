/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-sarek-clinical — Centralized Filtering & Classification Thresholds
    =====================================================================
    Edit this file to adjust variant filtering, ACMG classification, and
    clinical biomarker thresholds.  All modules and scripts read from here.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    filters {

        // ── Germline SNV Filtering ──────────────────────────────────────────
        germline_snv {
            min_dp              = 5        // Minimum read depth
            vaf_min_high        = 0.20     // Min VAF for HIGH-impact variants (applied only when DP >= vaf_floor_min_dp)
            vaf_min_moderate    = 0.20     // Min VAF for MODERATE-impact variants (same)
            vaf_floor_min_dp    = 20       // Below this depth the VAF floor is not applied (QC_FLAG "DP<20")
            vaf_max             = 0.75     // Not a filter: VAF >= this with no GT -> HOM; HET call above it -> "HET(VAF alta)"
            multi_hit_distance  = 30       // bp distance for multi-hit same-exon filter
            multi_hit_vaf       = 0.40     // VAF threshold for multi-hit filter
            multi_hit_min_gq    = 20       // Multi-hit: a pair member with GQ below this (or FILTER != PASS) is removed
            gnomad_rescue_max   = 50       // Max variants to rescue via gnomAD API per sample
            noncoding_splice    = true     // Also splice-region / synonymous / intronic variants
                                           // (LOW / MODIFIER) of panel genes, kept only if
                                           // SpliceAI >= acmg.spliceai_pp3 or ClinVar P/LP;
                                           // needs SpliceAI (params.spliceai)
        }

        // ── Germline CNV (GATK gCNV) ────────────────────────────────────────
        // Only panel genes are reported; non-panel genes are excluded entirely.
        // exclude_genes: panel genes kept for SNVs / somatic LOH but left out of
        // germline CNV (somatic oncogenes: a germline gain or loss is not a
        // predisposition mechanism; AR would also show the male X as CN=1).
        germline_cnv {
            min_qa              = 4        // Min allele quality for panel genes
            lowmap_min_frac     = 0.5      // Segment flagged low-mappability (shown apart, not correlated) if >= this fraction of its panel exon bp is in --gcnv_lowmap_bed
            exclude_genes       = 'AR,BRAF,CCND1,CCND2,CCND3,CCNE1,CDK6,EGFR,ERBB2,FGFR1,FGFR2,FGFR3,KRAS,MDM2,MDM4,MYC'
        }

        // ── Somatic SNV / TMB Filtering ─────────────────────────────────────
        somatic_snv {
            min_dp              = 10       // Minimum tumor DP
            min_af              = 0.05     // Minimum allele fraction for TMB
            min_alt_reads       = 10       // Minimum ALT-supporting reads (TMB + signatures)
        }

        // ── Somatic CNV ─────────────────────────────────────────────────────
        somatic_cnv {
            amp_threshold       = 5        // CN >= this = amplification
        }

        // ── ACMG 2015 Classification ────────────────────────────────────────
        acmg {
            // ClinVar review stars needed for the ClinVar class to be final
            // (2 = multiple submitters no conflicts / expert panel / guideline).
            // Below it: P/LP -> ACMG score, floor VUS (except BA1), flagged for review;
            // B/LB -> ACMG score, not removed by the germline filter;
            // VUS >= threshold stays VUS but may go down to LB/B by BS1/BA1.
            clinvar_min_stars   = 2

            // Population frequency thresholds
            // frequency_metric 'faf95': BA1/BS1 use the max gnomAD filtering AF (95% CI)
            // across ancestry groups (AF when unavailable); PM2 needs AF AND FAF95 below
            // pm2_af. 'af': overall gnomAD AF only (previous behaviour).
            frequency_metric    = 'faf95'
            ba1_af              = 0.05     // frequency > this → Benign (stand-alone)
            pm2_af              = 0.001    // frequency < this → PM2_Supporting (rare variant)
            bs1_af              = 0.01     // frequency > this → BS1 (strong benign)

            // ClinGen VCEP gene specifications (bin/acmg_shared.py VCEP_SPECS / VCEP_PM1,
            // CSpec registry, Released only): gene-specific BA1 / BS1 / BS1_Sup / PM2 for
            // APC ATM BRAF BRCA1 BRCA2 CDH1 DICER1 ENG KRAS MLH1 MSH2 MSH6 PALB2 PMS2 PTEN
            // TP53 VHL (needs the gnomAD resource with grpmax columns), and PM1 for
            // TP53 PTEN DICER1 ENG VHL KRAS BRAF. Other genes: the thresholds above.
            vcep_specs          = true

            // Evidence points (Tavtigian 2020: Supporting 1, Moderate 2, Strong 4, Very strong 8)
            pvs1_score          = 8        // PVS1: nonsense / frameshift (not last exon), splice +-1/2, other HIGH
            pvs1_strong_score   = 4        // PVS1_Strong: nonsense / frameshift in the last exon, >= 10% protein lost
            pvs1_moderate_score = 2        // PVS1_Moderate: last exon with < 10% lost, or start_lost
            pvs1_last_exon_min_lost = 0.10 // Fraction of protein lost in the last exon for PVS1_Strong
            pm4_score           = 2        // PM4: stop_lost
            pm2_score           = 1        // PM2_Supporting (ClinGen SVI 2020)
            ps1_score           = 4        // PS1: same amino-acid change as a ClinVar P/LP missense
            pm5_score           = 2        // PM5: other missense at a residue with a ClinVar P/LP missense
            pm1_score           = 2        // PM1 Moderate: VCEP hotspot / critical domain
            pm1_sup_score       = 1        // PM1 Supporting (PP3 + PM1 never above 4 points)
            bs1_score           = -4       // Allele frequency above expected
            bs1_sup_score       = -1       // BS1_Supporting (VCEP: BRCA1/2, PTEN, ENG)

            // Genes where loss of function is not the cancer mechanism: HIGH variants get no PVS1
            pvs1_not_applicable = 'ALK,AR,BRAF,CCND1,CCND2,CCND3,CCNE1,CDK4,CDK6,EGFR,EPCAM,ERBB2,FGFR1,FGFR2,FGFR3,GREM1,HOXB13,KIF1B,KIT,KRAS,MDM2,MDM4,MET,MITF,MYC,PDGFRA,PIK3CA,POLD1,POLE,RECQL,RET'

            // REVEL cut-offs (ClinGen calibration, Pejaver et al. 2022)
            revel_pp3_strong    = 0.932    // PP3 Strong     (>=, +4)
            revel_pp3_moderate  = 0.773    // PP3 Moderate   (>=, +2)
            revel_pp3_sup       = 0.644    // PP3 Supporting (>=, +1)
            revel_bp4_sup       = 0.290    // BP4 Supporting (<=, -1)
            revel_bp4_moderate  = 0.183    // BP4 Moderate   (<=, -2)
            revel_bp4_strong    = 0.016    // BP4 Strong     (<=, -4)

            // SpliceAI (ClinGen splicing recommendations, Walker et al. 2023)
            spliceai_pp3        = 0.2      // max delta >= this → PP3_Supporting (splicing)
            spliceai_bp4        = 0.1      // missense BP4 only if max delta <= this

            // Final classification point thresholds (Tavtigian 2020)
            score_p             = 10       // Points >= this → Pathogenic
            score_lp            = 6        // Points >= this → Likely Pathogenic (6..9)
            score_lb            = -1       // Points <= this → Likely Benign (-1..-6)
            score_b             = -7       // Points <= this → Benign
        }

        // ── Clinical Biomarker Thresholds ───────────────────────────────────
        biomarkers {
            tmb_high            = 10.0     // TMB-H (mut/Mb)
            tmb_borderline      = 6.0      // TMB borderline (mut/Mb)
            msi_high            = 3.5      // MSI-H threshold (%)
            msi_borderline      = 1.5      // MSI borderline (%)
            hrd_high            = 0.45     // HRD+ probability
            hrd_borderline      = 0.30     // HRD borderline probability
        }

        // ── Quality Control ─────────────────────────────────────────────────
        qc {
            low_cov_threshold   = 50       // Tumor mean coverage warning threshold (X)
        }

        // ── Mutational Signatures ───────────────────────────────────────────
        signatures {
            min_activity        = 0.05     // Min activity (mut/Mb) to report
            mmr_sbs             = 'SBS6,SBS15,SBS20,SBS21,SBS26,SBS44'
            mmr_id              = 'ID1,ID2'
            hrd_sbs             = 'SBS3,SBS8'
        }

        // ── Somatic Consensus (Mutect2 ∩ Strelka2) ────────────────────────
        consensus {
            min_callers         = 2        // 2 = Mutect2 and Strelka2; 1 = every Mutect2 PASS (Strelka2-private calls never enter)
        }
    }
}
