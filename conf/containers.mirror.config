/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Mirrored container images (Camino B) — INITIAL TEMPLATE (tags, NOT pinned)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ⚠️  Digests are NOT pinned yet. This template points at the org registry by
        TAG so `-profile mirror` works as soon as the images are pushed, but tags
        are mutable. Run docker/mirror_images.sh to overwrite this file with
        immutable sha256 digests (the actual Camino B reproducibility guarantee).

    Default registry below is ghcr.io/genuit-lbmu. If you mirror elsewhere, run
    the script with MIRROR_REGISTRY set and it will regenerate this file.

    Enable with:  -profile docker,mirror   (or  singularity,mirror)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withLabel:snpsift     { container = 'ghcr.io/genuit-lbmu/snpeff:5.1--hdfd78af_2' }
    withLabel:snpeff_mane { container = 'ghcr.io/genuit-lbmu/snpeff:5.2--hdfd78af_1' }
    withLabel:spliceai    { container = 'ghcr.io/genuit-lbmu/spliceai:1.3.1--pyh864c0ab_1' }
    withLabel:bcftools    { container = 'ghcr.io/genuit-lbmu/bcftools:1.20--h8b25389_0' }
    withLabel:gatk        { container = 'ghcr.io/genuit-lbmu/gatk:4.6.2.0' }
    withLabel:hrprofiler  { container = 'ghcr.io/genuit-lbmu/hrprofiler:1.0-full' }
    withLabel:r_base      { container = 'ghcr.io/genuit-lbmu/r-annotation:1.0.0' }
    withLabel:civicpy     { container = 'ghcr.io/genuit-lbmu/civicpy:5.4.0' }
    withLabel:sigprofiler { container = 'ghcr.io/genuit-lbmu/sigprofiler:0.1.8' }
}
