/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-track file suffixes for the somatic SNV processes run under aliases
    (subworkflows/local/somatic/main.nf). The core panel has no suffix.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/
process {
    withName: '.*:(SNPSIFT_FILTER|SNPSIFT_EXTRACT|ANNOTATE_CONSENSUS)_SECOND_HIT' {
        ext.suffix = '.second_hit'
    }
    withName: '.*:(SNPSIFT_FILTER|SNPSIFT_EXTRACT|ANNOTATE_CONSENSUS|CIVIC_ANNOTATE|CIVIC_EXTRACT)_TSO500' {
        ext.suffix = '.tso500'
    }
}
